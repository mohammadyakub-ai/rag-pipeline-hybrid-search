# Copy to .env to configure the stack. Everything has a sensible default.
#
# OPENROUTER_API_KEY=<your key>  <- preferred: routes chat/generation/judges
#                                     through the OpenRouter SDK.
# OPENAI_API_KEY=<your key>      <- used for embeddings (text-embedding-3-small)
#                                     and as a chat fallback when no OpenRouter
#                                     key is set. An sk-or-v1- key pasted here is
#                                     treated as OpenRouter automatically.
# Without any key the stack runs offline on mock embeddings; /v1/retrieve and
# the dashboard's comparison still work, /v1/ask returns 503.
OPENROUTER_API_KEY=
RAG_CONFIDENCE_THRESHOLD=0.5
CHROMA_HOST=chroma
CHROMA_PORT=8000