# RAG API + seed service image.
#
# Runs the FastAPI service and doubles as the image the one-shot `seed`
# compose service runs in. Talks to a separate ChromaDB server when
# CHROMA_HOST is set; otherwise uses its own persistent store under /app/data.

FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app

WORKDIR /app

# Install Python deps first so the layer is cached across source changes.
COPY requirements.txt /
RUN pip install --no-cache-dir -r /requirements.txt

# Application source.
COPY src/ ./src/
COPY scripts/ ./scripts/

# Sample documentation corpus used by the seed service. `data/raw` must stay
# buildable even though runtime vector data is excluded via .dockerignore.
COPY data/raw/ /app/corpus/

EXPOSE 8000

# Callers run the API with uvicorn directly in compose.
CMD ["uvicorn", "rag_pipeline.api:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]